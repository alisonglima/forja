# Copie para .env (./kit.sh setup faz isso). NUNCA publique o .env.
# OPCIONAL: chave da API do Gemini, so para voices.provider = "gemini" (aistudio.google.com/apikey).
# O padrao do kit e voices.provider = "google_ai_studio": voce gera as vozes com a sua conta
# em projects/<nome>/voices/<id>.wav. `files` e alias e le os mesmos WAVs. Sem chave, o kit funciona.
GEMINI_API_KEY=

# Chromium em container (so se usar o perfil "browser"): usuario e senha da tela em https://localhost:3001
BROWSER_USER=forja
BROWSER_PASSWORD=

# Usuario do container (o kit.sh setup preenche com o seu; nunca root). Em Windows/Docker Desktop pode ficar 1000.
FORJA_UID=1000
FORJA_GID=1000

# Limites de recurso do container "forja"
DUB_CPUS=4
DUB_MEM=6g
TZ=America/Sao_Paulo

# Interface aberta no Chromium opcional (ex.: https://aistudio.google.com/)
BROWSER_START_URL=https://aistudio.google.com/
